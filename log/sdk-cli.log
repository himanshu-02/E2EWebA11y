ge,\n      vp: window.innerWidth + 'x' + window.innerHeight,\n      scr: screen.width + 'x' + screen.height,\n      dpr: window.devicePixelRatio || 1,\n      is_iframe: window.self !== window.top\n    };\n  } catch (e) {\n    return { error: \"Context collection failed\" };\n  }\n}\n\nfunction serializeError(err) {\n  try {\n    const errorInfo = {\n      name: err.name || 'UnknownError',\n      message: err.message || String(err),\n      stack: err.stack || 'No stack trace available',\n      type: err.constructor ? err.constructor.name : typeof err,\n      toString: err.toString ? err.toString() : String(err)\n    };\n\n    // Capture additional error properties if they exist\n    if (err.cause) {\n      errorInfo.cause = err.cause instanceof Error ? serializeError(err.cause) : err.cause;\n    }\n    if (err.code) {\n      errorInfo.code = err.code;\n    }\n    if (err.lineNumber) {\n      errorInfo.lineNumber = err.lineNumber;\n    }\n    if (err.fileName) {\n      errorInfo.fileName = err.fileName;\n    }\n    if (err.columnNumber) {\n      errorInfo.columnNumber = err.columnNumber;\n    }\n\n    // Ensure stack trace is captured in full (no truncation)\n    if (err.stack && err.stack.length > 0) {\n      errorInfo.stack_full = err.stack;\n      errorInfo.stack_length = err.stack.length;\n    }\n\n    return errorInfo;\n  } catch (serializationError) {\n    // Fallback if error serialization itself fails\n    return {\n      serialization_failed: true,\n      original_error_string: String(err),\n      serialization_error: String(serializationError)\n    };\n  }\n}\n\nfunction sendInstrumentationEvent(message, logLevel, additionalInfo = {}) {\n  try {\n    additionalInfo.sdk_payload = payloadToSend || \"No Payload Provided\";\n    additionalInfo.client_context = getClientContext();\n\n    const eventPayload = {\n      data: {\n        product: SERVER_CONFIG.PRODUCT,\n        module: SERVER_CONFIG.MODULE,\n        team: SERVER_CONFIG.TEAM,\n        app_version: SERVER_CONFIG.APP_VERSION,\n        build_id: SERVER_CONFIG.BUILD_ID,\n        user_id: SERVER_CONFIG.USER_ID,\n        url: window.location.href,\n        timestamp: new Date().toISOString(),\n        log_level: logLevel,\n        message: message,\n        log_id: generateUUID(),\n        additional_info: additionalInfo\n      },\n      event_type: \"frontend_app_logs\",\n      api_key: SERVER_CONFIG.API_KEY\n    };\n\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() => controller.abort(), 3000); // 3 second timeout\n\n    fetch(SERVER_CONFIG.LOGGING_ENDPOINT, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(eventPayload),\n      keepalive: true,\n      signal: controller.signal\n    })\n      .finally(() => clearTimeout(timeoutId))\n      .catch(function() {}); // Silently handle errors including abort\n  } catch (e) {}\n}\n\n// --- CORE LOGIC ---\n\nfunction findAccessibilityAutomationElement() {\n  return document.querySelector('#accessibility-automation-element');\n}\n\nfunction waitForScannerReadiness(retryCount = 100, retryInterval = 100) {\n  return new Promise((resolve, reject) => {\n    let count = 0;\n    const intervalID = setInterval(() => {\n      if (count > retryCount) {\n        clearInterval(intervalID);\n        reject(new Error('Accessibility Automation Scanner is not ready on the page.'));\n      } else if (findAccessibilityAutomationElement()) {\n        clearInterval(intervalID);\n        resolve({ status: 'success' });\n      } else {\n        count += 1;\n      }\n    }, retryInterval);\n  });\n}\n\nfunction scanForAccessibility() {\n  const scanStartTime = performance.now();\n  const detailPayload = payloadToSend ? payloadToSend : {};\n\n  const requestEvent = new CustomEvent('A11Y_SCAN', {\n    detail: {\n      ...detailPayload,\n      middlewareStartTime,\n      scanStartTime,\n      readinessCheckTime: scanStartTime - middlewareStartTime\n    }\n  });\n\n  const responseEvent = 'A11Y_SCAN_FINISHED';\n  const responseEventListener = () => {\n    window.removeEventListener(responseEvent, responseEventListener);\n    console.info(\"Accessibility Automation Scanner completed the scan.\");\n    callback({ success: true, msg: \"Accessibility Automation Scanner completed the scan.\" });\n  };\n\n  window.addEventListener(responseEvent, responseEventListener);\n\n  console.info(\"Requesting Accessibility Automation Scanner to perform a scan.\");\n  window.dispatchEvent(requestEvent);\n}\n\n// --- EXECUTION FLOW ---\n\ntry {\n  const isHttpOrHttps = /^(http|https):$/.test(window.location.protocol);\n\n  if (findAccessibilityAutomationElement()) {\n    // Scenario 1: Already Ready -> Success\n    console.info(\"Scanner is already ready on the page.\");\n    scanForAccessibility();\n\n  } else if (isHttpOrHttps) {\n    waitForScannerReadiness()\n      .then((result) => {\n        if (result.status === 'success') {\n          // Scenario 2: Ready after wait -> Success\n          console.info(\"Scanner is now ready on the page after multiple retries.\");\n          scanForAccessibility();\n        }\n      })\n      .catch((error) => {\n        // Scenario 3: Timeout -> ERROR LOG\n        console.error(\"Scanner is not ready on the page after multiple retries.\", error);\n\n        sendInstrumentationEvent(\"Scanner is not ready on the page after multiple retries\", \"ERROR\", {\n          error_message: error.message || String(error),\n          attempts: 100\n        });\n        callback({ success: false, msg: \"Scanner is not ready on the page after multiple retries.\" });\n      });\n  } else {\n    // Scenario 4: Invalid URL -> No Log\n    console.warn(\"Unable to perform accessibility scan, Invalid URL.\");\n    callback({ success: false, msg: \"Unable to perform accessibility scan, Invalid URL.\" });\n  }\n} catch (err) {\n  // Scenario 5: Unexpected Script Error -> ERROR LOG\n  // Capture comprehensive error details for debugging without customer reproduction\n  console.error(\"Critical error in accessibility scan script\", err);\n\n  const errorDetails = serializeError(err);\n  sendInstrumentationEvent(\"Critical error in accessibility scan script\", \"ERROR\", {\n    error_details: errorDetails,\n    error_message: errorDetails.message,\n    error_name: errorDetails.name,\n    error_type: errorDetails.type,\n    stack_trace: errorDetails.stack,\n    stack_trace_full: errorDetails.stack_full || errorDetails.stack,\n    stack_trace_length: errorDetails.stack_length || (errorDetails.stack ? errorDetails.stack.length : 0)\n  });\n  callback({ success: false, msg: \"Unexpected error in scan.js execution.\" });\n}\n"},{"name":"saveResults","command":"/* browserstack_accessibility_automation_script */\nconst callback = arguments[arguments.length - 1];\nconst payloadToSend = arguments[0];\nconst middlewareStartTime = performance.now();\n\nfunction waitForScannerReadiness(retryCount = 100, retryInterval = 100) {\n  return new Promise((resolve, reject) => {\n    let count = 0;\n    const intervalID = setInterval(() => {\n      if (count > retryCount) {\n        clearInterval(intervalID);\n        reject(new Error('Accessibility Automation Scanner is not ready on the page.'));\n      } else if (findAccessibilityAutomationElement()) {\n        clearInterval(intervalID);\n        resolve({ status: 'success' });\n      } else {\n        count += 1;\n      }\n    }, retryInterval);\n  });\n}\n\nfunction saveAccessibilityResults() {\n  const saveStartTime = performance.now();\n  const requestEvent = new CustomEvent('A11Y_SAVE_RESULTS', {\n    detail: {\n      ...payloadToSend,\n      middlewareStartTime,\n      saveStartTime,\n      readinessCheckTime: saveStartTime - middlewareStartTime\n    }\n  });\n  const responseEvent = 'A11Y_RESULTS_SAVED';\n\n  const responseEventListener = (response) => {\n    window.removeEventListener(responseEvent, responseEventListener);\n    console.info(\"Accessibility Automation Scanner saved the test case results.\");\n    callback({ success: response?.detail?.success || false, msg: response?.detail?.msg || 'No response from Accessibility Automation Scanner' });\n  };\n\n  window.addEventListener(responseEvent, responseEventListener);\n\n  console.info(\"Requesting Accessibility Automation Scanner to save the test case results.\");\n  window.dispatchEvent(requestEvent);\n}\n\nfunction findAccessibilityAutomationElement() {\n  return document.querySelector('#accessibility-automation-element');\n}\n\nconst isHttpOrHttps = /^(http|https):$/.test(window.location.protocol);\n\nif (findAccessibilityAutomationElement()) {\n  console.info(\"Scanner is already ready on the page.\");\n  saveAccessibilityResults();\n} else if (isHttpOrHttps) {\n  waitForScannerReadiness()\n    .then((result) => {\n      if (result.status === 'success') {\n        console.info(\"Scanner is now ready on the page after multiple retries.\");\n        saveAccessibilityResults();\n      }\n    })\n    .catch((error) => {\n      console.error(\"Scanner is not ready on the page after multiple retries.\", error);\n      callback({ success: false, msg: \"Scanner is not ready on the page after multiple retries.\" });\n    });\n} else {\n  console.warn(\"Unable to save accessibility results, Invalid URL.\");\n  callback({ success: false, msg: \"Unable to save accessibility results, Invalid URL.\" });\n}\n"},{"name":"getResults","command":"/* browserstack_accessibility_automation_script */\nconst callback = arguments[arguments.length - 1];\n\nfunction waitForScannerReadiness(retryCount = 100, retryInterval = 100) {\n  return new Promise((resolve, reject) => {\n    let count = 0;\n    const intervalID = setInterval(() => {\n      if (count > retryCount) {\n        clearInterval(intervalID);\n        reject(new Error('Accessibility Automation Scanner is not ready on the page.'));\n      } else if (findAccessibilityAutomationElement()) {\n        clearInterval(intervalID);\n        resolve({ status: 'success' });\n      } else {\n        count += 1;\n      }\n    }, retryInterval);\n  });\n}\n\nfunction getAccessibilityResults() {\n  const requestEvent = new CustomEvent('A11Y_GET_RESULTS');\n  const responseEvent = 'A11Y_RESULTS_RESPONSE';\n\n  const responseEventListener = () => {\n    window.removeEventListener(responseEvent, responseEventListener);\n    console.info(\"Accessibility Automation Scanner provided the results.\");\n    callback(event.detail);\n  };\n\n  window.addEventListener(responseEvent, responseEventListener);\n\n  console.info(\"Requesting Accessibility Automation Scanner for the results.\");\n  window.dispatchEvent(requestEvent);\n}\n\nfunction findAccessibilityAutomationElement() {\n  return document.querySelector('#accessibility-automation-element');\n}\n\nconst isHttpOrHttps = /^(http|https):$/.test(window.location.protocol);\n\nif (findAccessibilityAutomationElement()) {\n  console.info(\"Scanner is already ready on the page.\");\n  getAccessibilityResults();\n} else if (isHttpOrHttps) {\n  waitForScannerReadiness()\n    .then((result) => {\n      if (result.status === 'success') {\n        console.info(\"Scanner is now ready on the page after multiple retries.\");\n        getAccessibilityResults();\n      }\n    })\n    .catch((error) => {\n      console.error(\"Scanner is not ready on the page after multiple retries.\", error);\n      callback({ success: false, msg: \"Scanner is not ready on the page after multiple retries.\" });\n    });\n} else {\n  console.warn(\"Unable to fetch accessibility results, Invalid URL.\");\n  callback({ success: false, msg: \"Unable to fetch accessibility results, Invalid URL.\" });\n}\n"},{"name":"getResultsSummary","command":"/* browserstack_accessibility_automation_script */\nconst callback = arguments[arguments.length - 1];\n\nfunction waitForScannerReadiness(retryCount = 100, retryInterval = 100) {\n  return new Promise((resolve, reject) => {\n    let c