s: false, msg: \"Unable to fetch accessibility results summary, Invalid URL.\" });\n}\n"}],"commandsToWrap":{"scriptsToRun":["scan","saveResults","getResults","getResultsSummary"],"commands":[{"library":"org.openqa.selenium","method":"execute","module":"remote","name":"get","class":"RemoteWebDriver"},{"library":"org.openqa.selenium","method":"refresh","module":"remote.RemoteWebDriver","name":"refresh","class":"RemoteNavigation"},{"library":"org.openqa.selenium","method":"forward","module":"remote.RemoteWebDriver","name":"goForward","class":"RemoteNavigation"},{"library":"org.openqa.selenium","method":"click","module":"remote","name":"clickElement","class":"RemoteWebElement"},{"library":"org.openqa.selenium","method":"sendKeys","module":"remote","name":"sendKeysToElement","class":"RemoteWebElement"},{"library":"org.openqa.selenium","method":"submit","module":"remote","name":"submitElement","class":"RemoteWebElement"},{"library":"org.openqa.selenium","method":"frame","module":"remote.RemoteWebDriver","name":"switchToFrame","class":"RemoteTargetLocator"},{"library":"org.openqa.selenium","method":"window","module":"remote.RemoteWebDriver","name":"switchToWindow","class":"RemoteTargetLocator"},{"library":"org.openqa.selenium","method":"perform","module":"interactions","name":"actions","class":"Actions"}]}},"isAppAccessibility":false}}
